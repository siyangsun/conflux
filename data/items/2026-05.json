  },
  {
    "id": "arena:96761405",
    "source": "arena",
    "type": "block",
    "text": "2) Targeted deep clean\nUse dropper: 1–2 drops alcohol at key edge\nRapidly tap key ~20–30 times\nTilt laptop so liquid drains out (not deeper in)",
    "url": "https://www.are.na/block/45891035",
    "published_at": "2026-05-06T13:55:46.000Z",
    "fetched_at": "2026-11-03T16:09:01.296Z",
    "images": [],
    "tags": [],
