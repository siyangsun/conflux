  {
    "kind": "reblog",
    "images": [
      "https://images-wixmp-ed30a86b8c4ca887773594c2.wixmp.com/f/77daab12-4fc8-4928-ac0f-7f7543112553/d9q4810-e2903156-0183-4d1b-9e25-5c9a14be0d33.jpg/v1/fit/w_300,h_507,q_70,strp/khamsin_refinery_complex_by_ungdi_sea_d9q4810-300w.jpg?token=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..dw9QgZnVNa-zsuAUoXWPqd77Sr5IbwO-osZ-TdRcWCA"
